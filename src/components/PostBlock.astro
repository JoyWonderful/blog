---
import "../styles/components/PostBlock.scss";
import config from "../config.json";
const { frontMatter, id, isTitleLink } = Astro.props;
---
<div class="post-block">
    <header>
        <h2 class="post-title">
            {isTitleLink ?
            <a href={config.posts_path+"/"+id}>{frontMatter.title}</a>:
            frontMatter.title}
        </h2>
        <div class="post-meta">
            <span class="item">
                <i class="far fa-calendar"></i>
                <span>发表于</span>
                <time datetime={frontMatter.date.toISOString()} title={frontMatter.date.toLocaleString()}>{`${frontMatter.date.getFullYear()}-${String(frontMatter.date.getMonth()+1).padStart(2,"0")}-${String(frontMatter.date.getDate()).padStart(2,"0")}`}</time>
            </span>
            {frontMatter.updated &&
            <span class="item">
                <i class="far fa-calendar-check"></i>
                <span>更新于</span>
                <time datetime={frontMatter.updated.toISOString()} title={frontMatter.updated.toLocaleString()}>{`${frontMatter.updated.getFullYear()}-${String(frontMatter.updated.getMonth()+1).padStart(2,"0")}-${String(frontMatter.updated.getDate()).padStart(2,"0")}`}</time>
            </span>
            }
            {frontMatter.categories &&
            <span class="item">
                <i class="far fa-folder"></i>
                <span>分类于</span>
                <a href={config.gategories_path+"/"+frontMatter.categories}>{frontMatter.categories}</a>
            </span>}
        </div>
    </header>
    <article>
        <slot />
    </article>
</div>
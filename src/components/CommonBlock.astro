---
const { title, subtitle } = Astro.props;
---
<div class="common-block">
    {title && <h1>{title}</h1>}
    {subtitle && <span class="subtitle">{subtitle}</span>}
    <slot />
</div>

<style is:global lang="scss">
    @use "../styles/variables" as *;

    .common-block {
        margin-top: $card_margin_top;
        padding: 30px 40px;
        border-radius: $border_radius;
        box-shadow: $box_shadow;
        background: #fff;
        h1 {
            display: block;
            margin: 0;
            text-align: center;
            font-size: 1.5em;
        }
        &:not(:has(.subtitle)) h1 {
            border-bottom: none;
            margin-bottom: 10px;
        }
        .subtitle {
            display: block;
            color: $color_text_1;
            text-align: center;
        }
        > :last-child {
            margin-bottom: 0!important;
        }
    }
</style>
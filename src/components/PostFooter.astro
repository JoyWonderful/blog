---
import type { CollectionEntry } from "astro:content";
import PostLicense from "~/components/PostLicense.astro";
import "~/styles/components/PostFooter.scss";
import { blogPosts } from "~/scripts/helpers/site-posts-stats";
import config from "~/config.json";

const { id } = Astro.props;

const postIndex = blogPosts.findIndex((post:CollectionEntry<"blogPosts">) => post.id == id);

var postTags;
if(typeof(blogPosts[postIndex].data.tags) == "string") postTags = [blogPosts[postIndex].data.tags];
else postTags = blogPosts[postIndex].data.tags;

var prevHref = null, nextHref = null;
if(postIndex - 1 >= 0) prevHref = `${config.posts_path}/${blogPosts[postIndex-1].id}`;
if(postIndex + 1 < blogPosts.length) nextHref = `${config.posts_path}/${blogPosts[postIndex+1].id}`;

var license = blogPosts[postIndex].data.license || config.license_default || undefined;
---
<footer class="post-footer" data-pagefind-body>
    <div class="post-categories">
        <i class="fa fa-folder-open fa-fw" title="分类"></i>
        <a
            href={`${config.categories_path}/${blogPosts[postIndex].data.categories}`}
            data-pagefind-filter="categories"
        >{blogPosts[postIndex].data.categories}</a>
    </div>
    <div class="post-tags">
        <i class="fa fa-tags fa-fw" title="标签"></i>
        {postTags.map((tag:string) => {
            var tag_href = `${config.tags_path}/${tag}`;
            return <a href={tag_href} data-pagefind-filter="tags">{tag}</a>;
        })}
    </div>
    {license &&
    <div class="post-license" id="LICENSE">
        <PostLicense license={license} reason={blogPosts[postIndex].data.license_reason} />
    </div>
    }
    <nav class="post-nav" data-pagefind-ignore>
        {prevHref && <a rel="prev" href={prevHref}><i class="fa fa-angle-left fa-fw"></i><span>{blogPosts[postIndex-1].data.title}</span></a>}
        {nextHref && <a rel="next" href={nextHref}><span>{blogPosts[postIndex+1].data.title}</span><i class="fa fa-angle-right fa-fw"></i></a>}
    </nav>
</footer>
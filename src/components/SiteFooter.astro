---
import "~/styles/components/SiteFooter.scss";
import config from "~/config.json";

const YEAR = new Date().getFullYear();
const ICON_LIST = [
    ["fa fa-brush fa-wag", "#b197fc"],
    ["fa fa-code fa-float", "#74c0fc"],
    ["fa fa-laptop-code fa-fade", "#241500"],
    ["fa fa-pen-clip fa-jello", "#f78aff"],
    ["fa fa-heart fa-beat-fade", "#ff6666"]
];
const PICKER = Math.floor(Math.random() * (ICON_LIST.length - 0) + 0); // 不包含最大值，包含最小值
var color_str = `--hover-color:${ICON_LIST[PICKER][1]}`;
---
<footer>
    <span class="footer-basic">Build in {YEAR}<i class={ICON_LIST[PICKER][0]} style={color_str}></i>{config.author}</span>
    <span class="footer-license">
        除特别说明外，本站所有文章都在 <a target="_blank" rel="noopener noreferer" href="https://creativecommons.org/licenses/by-nc/4.0/deed.zh-hans" title="Creative Commons Attribution-NonCommercial 4.0 International (署名—非商业性使用 4.0 协议 国际版)">CC BY-NC 4.0</a> 下发布<br />
        <i class="fab fa-creative-commons"></i><i class="fab fa-creative-commons-by" title="署名"></i><i class="fab fa-creative-commons-nc" title="非商业性使用"></i>
    </span>
</footer>

<style lang="scss">
    @use "../styles/variables" as *;

    footer {
        .footer-basic {
            i[class*="fa"] {
                margin: 0 10px;
                animation-play-state: paused;
                animation-fill-mode: backwards;
            }
            &:hover i[class*="fa"] {
                color: var(--hover-color);
                animation-play-state: running;
            }
        }
        .footer-license {
            i[class*="fa-creative-commons-"] {
                transition: color $transition_time;
                &:hover {
                    color: $color_5;
                }
            }
        }
    }
</style>
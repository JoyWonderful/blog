---
// import PagefindConfig from "astro-pagefind/components/PagefindConfig.astro";
import "@pagefind/component-ui/css/pagefind-component-ui.css";
import "~/styles/components/Search.scss";
---
{/*<PagefindConfig />*/}
<script src="/pagefind/pagefind-component-ui.js" type="module" is:inline></script>

<pagefind-modal> {/* 搜索界面，默认可以为空，我只是加上了 filter-pane */}
    <pagefind-modal-header>
        <pagefind-input></pagefind-input>
    </pagefind-modal-header>
    <pagefind-modal-body>
        <pagefind-filter-pane style="margin-bottom:0.5rem"></pagefind-filter-pane>
        <pagefind-summary default-message="使用上方的筛选器可筛选分类、标签；你不仅可以搜索文章内容，也可以搜索文章发布/更新日期。"></pagefind-summary>
        <pagefind-results></pagefind-results>
    </pagefind-modal-body>
    <pagefind-modal-footer>
        <pagefind-keyboard-hints></pagefind-keyboard-hints>
    </pagefind-modal-footer>
</pagefind-modal>

<noscript>
<style>
    pagefind-modal-trigger, pagefind-modal {
        display: none;
    }
</style>
</noscript>
---
import { getAllCategories } from "~/scripts/helpers/site-posts-stats";
import config from "~/config.json";

const { matchCategory } = Astro.props;
const categories = getAllCategories();
---
<div class="title">分类导览</div>
<div class="categories-navigator">
    <ul>
        {[...categories].map((category) => { /* category[0] 是分类名 */
            var href = `${config.categories_path}/${category[0]}`;
            var name = category[0];
            if(matchCategory == name) {
                return <li  class="active"><a href={href}>{name}</a></li>;
            }
            else {
                return <li><a href={href}>{name}</a></li>
            }
        })}
    </ul>
</div>

<style lang="scss">
    @use "../../styles/variables" as *;
    @use "../../styles/mixins" as *;
    .categories-navigator ul {
        padding-left: 0;
        margin-bottom: 0;
        li {
            white-space: nowrap;
        }
        li a {
            border-bottom: 0;
        }
        li::marker {
            content: none;
        }
        li::before {
            @include fontawesome("\f07b");
            @extend %fa-fw;
            display: inline-block;
            margin-right: .2em;
            color: $color_theme;
            transition: color $transition_time;
        }
        li.active a {
            font-weight: bold; // 700s
        }
        li.active::before {
            content: "\f07c";
        }
        li:hover::before {
            color: $color_7;
        }
    }
</style>
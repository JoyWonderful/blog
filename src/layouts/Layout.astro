---
import config from "~/config.json";
---
<!DOCTYPE html>
<html lang={config.lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        {config.meta_generator && <meta name="generator" content={Astro.generator} />}
        <title><slot name="document-title" /></title>
        {config.favicon && <link rel="icon" href={config.favicon} />}
        <slot name="html-head" />
    </head>
    <body>
        <slot />
    </body>
</html>
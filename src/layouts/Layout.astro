---
import "~/styles/main.scss";
import { getSourcePathList } from "~/scripts/helpers/source-path";
import config from "~/config.json";

var source_path_list = getSourcePathList([0]);
---
<!DOCTYPE html>
<html lang={config.lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        {config.meta_generator && <meta name="generator" content={Astro.generator} />}
        <title><slot name="document-title" /></title>
        {source_path_list.map((source) => {
            if(source.endsWith(".css")) {
                return <link rel="stylesheet" href={source} />;
            }
            else if(source.endsWith(".js")) {
                return <script src={source}></script>;
            }
        })}
        <slot name="html-head" />
    </head>
    <body>
        <slot />
    </body>
</html>
---
import "~/styles/main.scss";
import config from "~/config.json";
---
<!DOCTYPE html>
<html lang={config.lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        {config.meta_generator && <meta name="generator" content={Astro.generator} />}
        <title><slot name="document-title" /></title>
        <link rel="stylesheet" href="https://new.src-jywon.pages.dev/fonts/fontawesome/css/all.min.css" />
        <link rel="stylesheet" href="https://new.src-jywon.pages.dev/fonts/lxgw/result.css" />
        <slot name="html-head" />
    </head>
    <body>
        <slot />
    </body>
</html>
---
import type { GetStaticPaths, MarkdownHeading } from "astro";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import { Markup } from "astro-remote";
import Main from "~/layouts/Main.astro";
import PostAside from "~/components/sidebar/PostAside.astro";
import PostBlock from "~/components/PostBlock.astro";
import Tabs from "~/components/post-tags/Tabs.astro";
import PostFooter from "~/components/PostFooter.astro";
import MathConfs from "~/components/MathConfs.astro";
import config from "~/config.json";

export const getStaticPaths = (async () => {
    const blogPosts = await getCollection("blogPosts");
    return blogPosts.map((post:CollectionEntry<"blogPosts">) => {
        return {
            params: {id: post.id},
            props: {post: post}
        };
    });
}) satisfies GetStaticPaths;

const { id } = Astro.params; // 这是传递的参数 [id]。
const { post } = Astro.props as any; // 这是当时传递的 `props: {post: post}`

const toc:MarkdownHeading[] = post.rendered.metadata.headings;
// depth 就是 h1, h2, h3, ... `h` 后面的数字
/* e.g
h2 => depth=2
    h3 => depth=3
    h3
        h4
        h4
    h3
h2
h2
    h3
 */
/* for(const item of toc) {
    Astro.logger.info(`{depth:${String(item.depth)}, slug:"${item.slug}", text:"${item.text}"},`);
} */
---
<Main matchHref={config.archives_path}>
    <Fragment slot="document-title">{post.data.title} | {config.title}</Fragment>
    <Fragment slot="html-head">
        {post.data.math && <MathConfs />}
    </Fragment>

    <Fragment slot="site-sidebar">
        <PostAside toc={toc} />
    </Fragment>

    <PostBlock frontMatter={post.data} id={id} isTitleLink={false}>
        <Markup
            content={post.rendered.html}
            components={{tabs: Tabs}}
        /> {/*将 <tabs></tabs> 替换为 Astro 组件 !!plugin remark-flexible-containers*/}
    </PostBlock>
    <PostFooter id={id} />

    <Fragment slot="html-body-script">
        <script src="~/scripts/code-copy.js"></script>
    </Fragment>
</Main>

---
import { Content } from "~/markdowns/about.md";
import Main from "~/layouts/Main.astro";
import CommonBlock from "~/components/CommonBlock.astro";
import config from "~/config.json";
import source from "~/config.source.json";
import { dependencies } from "~/../package.json";

const matchHref = "/about";
const pageTitle = config.menu_more.find((entry) => entry.href==matchHref)?.name;

var source_list = Object.values(source).flatMap((src_entry) => {
    if(typeof(src_entry) == "object") {
        return src_entry.package_list;
    }
});
delete source_list [source_list.findIndex((src_entry) => src_entry==undefined)]; // 丢掉那个 "$schema"
---
<Main matchHref={matchHref}>
    <Fragment slot="document-title">{pageTitle} | {config.title}</Fragment>

    <CommonBlock title={pageTitle} subtitle="从这里了解到关于所有的事情？不可能的。">
        <Content />

        <p><strong>Version:</strong><br />Built with {Astro.generator}.</p>

        <strong>NPM Dependencies:</strong><br />
        <pre style="margin-top:0;margin-bottom:30px;overflow-x:auto"><code>{
        Object.keys(dependencies).map((dep) => {
            return (<Fragment><a href={`https://npmmirror.com/package/${dep}`} rel="noopener noreferer" target="_blank">{dep}</a>: {dependencies[dep]}<br /></Fragment>)
        })}</code></pre>

        <strong>Using Source:</strong><br />
        <table>
            <thead>
                <tr>
                    <th scope="col">Package</th>
                    <th scope="col">Version</th>
                    <th scope="col">Files</th>
                </tr>
            </thead>
            <tbody>
                {source_list.map((src_entry) => {
                    if(src_entry == undefined) return;
                    return <>
                        <tr>
                            <th scope="row" rowspan={src_entry.file_path.length}>{src_entry.package}</th>
                            <td rowspan={src_entry.file_path.length}>{src_entry.version}</td>
                            <td>{src_entry.file_path[0]}</td>
                        </tr>
                        {src_entry.file_path.slice(1).map((file) => <tr><td>{file}</td></tr>) /* slice(1) 去掉头一个 */}
                    </>;
                })}
            </tbody>
        </table>

        <strong>Site Deploy Status:</strong> <span style="opacity:0.7">(deployed on CloudFlare Pages)</span>
        <div id="last-deploy-info">
            <span id="dpi-waiting">Please wait...</span>
        </div>
        <style is:global lang="scss">
            @use "../styles/variables" as *;
            #last-deploy-info {
                white-space: nowrap;
                overflow-x: auto;
                font-family: $font_mono;
                &[data-fetch-error] {
                    color: #db0000;
                }
            }
            #dpi-waiting {
                color: $color_text_0;
            }
        </style>
    </CommonBlock>
    <Fragment slot="html-body-script">
        <script>
            // https://docs.github.com/zh/rest/checks/runs?apiVersion=2022-11-28#list-check-runs-for-a-git-reference
            fetch("https://api.github.com/repos/JoyWonderful/blog/commits/heads/main/check-runs?check_name=Cloudflare%20Pages")
            .then((result) => {
                var deploy_element = document.querySelector("#last-deploy-info");
                if(!deploy_element) return;

                if(!result.ok) {
                    console.error(result.status);
                    deploy_element.setAttribute("data-fetch-error", "");
                    deploy_element.innerHTML = `Failed to fetch deploy data.<br>The server returned a status of ${result.status}.`;
                }

                var remain = result.headers.get("X-Ratelimit-Remaining"); // 获取速率限制
                console.debug("Ratelimit remaining: " + remain + "\nRate limit reset after: " + result.headers.get("X-Ratelimit-Reset"));
                if(remain == "0") {
                    console.debug("Too many requests.");
                    deploy_element.setAttribute("data-fetch-error", "");
                    deploy_element.innerHTML = `The number of requests is out of range.<br>Rate limit reset after: ${result.headers.get("X-Ratelimit-Reset")}.`;
                }

                return result.json();
            }, (err) => {
                var deploy_element = document.querySelector("#last-deploy-info");
                if(!deploy_element) return;
                console.error(err);
                deploy_element.setAttribute("data-fetch-error", "");
                deploy_element.innerHTML = `Failed to fetch deploy data.<br>${err}`;
            }).then((data) => {
                document.querySelector("#dpi-waiting")?.remove();
                var deploy_element = document.querySelector("#last-deploy-info");
                if(!deploy_element) return;
                deploy_element.innerHTML = data.check_runs[0].output.summary.replace(/\[View logs\]\(https?:\/\/.+\)/, "");
            });
        </script>
    </Fragment>
</Main>
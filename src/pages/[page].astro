---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import { getAllCategories, getAllTags } from "~/scripts/helpers/site-posts-stats";
import Main from "~/layouts/Main.astro";
import PostBlock from "~/components/PostBlock.astro";
import PaginationBar from "~/components/PaginationBar.astro";
import MathConfs from "~/components/MathConfs.astro";
import config from "~/config.json";

export const getStaticPaths = (async function({ paginate }) {
    const blogPosts = (await getCollection("blogPosts")).sort((a:any, b:any) => {
        return b.data.date.valueOf() - a.data.date.valueOf(); // 按发布时间排序
    });
    return paginate(blogPosts, {
        pageSize: config.post_per_page
    });
}) satisfies GetStaticPaths;

const { page } = Astro.props; // 分页 https://docs.astro.build/zh-cn/guides/routing/#page-%E5%B1%9E%E6%80%A7
const blogPosts:Array<any> = await getCollection("blogPosts");
var postLstContent:any[] = page.data; // page.data 就是上面传递的 blogPosts，即 [CollectionEntry](https://docs.astro.build/zh-cn/reference/modules/astro-content/#collectionentry) 类型的列表

var katexEnabled = false;
for(const post of postLstContent) {
    if(post.data.math) {
        katexEnabled = true; // 只要有其中一篇文章启用数学渲染，就加上数学渲染
        break;
    }
}

var categoriesCount = getAllCategories().size;
var tagsCount = getAllTags().size;
/*var tags getAllTags();
Astro.logger.info(`tagsCound:${tags.size}`);
var tags_iterator = tags.entries();
while(true) {
    var now = tags_iterator.next();
    if(now.done == true) break;
    Astro.logger.info(String(now.value));
}*/
---
<Main matchHref="/">
    <Fragment slot="document-title">{config.title}</Fragment>
    <Fragment slot="html-head">
        {katexEnabled && <MathConfs />}
    </Fragment>

    <Fragment slot="site-sidebar">
        <div class="title">统计信息</div>
        <div class="stat">
            <div class="stat-item"><span class="stat-number">{blogPosts.length}</span><span class="stat-text">文章</span></div>
            <div class="stat-item"><span class="stat-number">{categoriesCount}</span><span class="stat-text">分类</span></div>
            <div class="stat-item"><span class="stat-number">{tagsCount}</span><span class="stat-text">标签</span></div>
        </div>
        <style lang="scss">
            @use "../styles/variables" as *;

            .stat {
                display: flex;
                flex-flow: row wrap;
                justify-content: center;
                column-gap: .75rem;
            }
            .stat-item {
                span {
                    display: block;
                    text-align: center;
                }
                .stat-number {
                    font-weight: bold; // 700
                    color: $color_text_3;
                }
                .stat-text {
                    font-size: smaller;
                    color: $color_text_1
                }
            }
        </style>
    </Fragment>

    {postLstContent.map((post) => {
        // 正则 i: 不区分大小写
        return <PostBlock frontMatter={post.data} id={post.id} isTitleLink={true} set:html={post.rendered.html.split(/<!--[ ]*more[ ]*-->/i)[0]}></PostBlock>;
        // https://docs.astro.build/zh-cn/reference/content-loader-reference/#dataentryrendered
    })}

    <PaginationBar page={page} />
</Main>

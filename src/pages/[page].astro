---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "~/layouts/Layout.astro";
import PostBlock from "~/components/PostBlock.astro";
import PaginationBar from "~/components/PaginationBar.astro";
import config from "~/config.json";

export const getStaticPaths = (async function({ paginate }) {
    const blogPosts = (await getCollection("blogPosts")).sort((a:any, b:any) => {
        return b.data.date.valueOf() - a.data.date.valueOf(); // 按发布时间排序
    });
    return paginate(blogPosts, {
        pageSize: config.post_per_page
    });
}) satisfies GetStaticPaths;

const { page } = Astro.props; // 分页 https://docs.astro.build/zh-cn/guides/routing/#page-%E5%B1%9E%E6%80%A7
var postLstContent:any[] = page.data; // page.data 就是上面传递的 blogPosts，即 [CollectionEntry](https://docs.astro.build/zh-cn/reference/modules/astro-content/#collectionentry) 类型的列表
---
<Layout>
    <Fragment slot="document-title">{config.title}</Fragment>
    {postLstContent.map((post) => {
        // 正则 i: 不区分大小写
        return <PostBlock frontMatter={post.data} id={post.id} isTitleLink={true} set:html={post.rendered.html.split(/<!--[ ]*more[ ]*-->/i)[0]}></PostBlock>;
        // https://docs.astro.build/zh-cn/reference/content-loader-reference/#dataentryrendered
    })}
    <PaginationBar page={page} />
</Layout>

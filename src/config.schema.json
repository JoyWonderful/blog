{
    "$schema": "https://json-schema.org/draft/2020-12/schema",

    "title": "wablog",
    "description": "Config definitions for wablog.",
    "type": "object",
    "properties": {
        "$schema": {
            "type": "string"
        },
        
        "title": {
            "description": "The title for your site.",
            "type": "string"
        },
        "subtitle": {
            "description": "The subtitle for your site. (bio, description, .etc)",
            "type": "string"
        },
        "lang": {
            "description": "Language for your site. (Used for html.lang)",
            "type": "string"
        },

        "posts_path": {
            "description": "Your path for posts. (Used for a.href in posts.)",
            "type": "string",
            "default": "/posts"
        },
        "categories_path": {
            "description": "Your path for categories. (Used for a.href in posts.)",
            "type": "string",
            "default": "/categories"
        },
        "tags_path": {
            "description": "Your path for tags. (Used for a.href in posts.)",
            "type": "string",
            "default": "/tags"
        },

        "post_per_page": {
            "description": "Amount of displayed posts on per page.",
            "type": "integer",
            "default": 10
        },

        "meta_generator": {
            "description": "Whether give metadata generator in <head>.",
            "type": "boolean",
            "default": true
        }
    },
    "required": ["title", "subtitle", "lang", "posts_path", "categories_path", "tags_path", "post_per_page", "meta_generator"],
    "additionalProperties": false
}